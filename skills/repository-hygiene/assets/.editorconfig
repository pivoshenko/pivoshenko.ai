# === .editorconfig ===
# Purpose:  Lands at repository root. Sets cross-editor formatting baseline (UTF-8, LF, 2-space, 120-char lines).
# Tokens:   none
# Override: Add per-language [*.<ext>] blocks below the canon section. Do not change [*] universal defaults.
# === end ===
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 120
tab_width = 2
trim_trailing_whitespace = true

[{*.py,*.pyi,*.ipynb}]
indent_size = 4
tab_width = 4
