# === .gitignore.base ===
# Purpose:  Lands at repository root as the top of `.gitignore`. Universal ignores (OS cruft, editors, env, logs) prepended before any language-specific block from gitignore/<lang>.gitignore.
# Tokens:   none
# Override: Append repository-specific paths below the canon section. Do not remove grouping headers (`# OS`, `# Editors`, `# Env`, `# Logs`, `# Misc`).
# === end ===

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*.swo

# Env
.env
.env.local
.env.*.local

# Logs
*.log

# Misc
.cache/
.tmp/
