// OpenGraph card for a Next.js App Router site. Rendered at the edge by `next/og`.
//
// REQUIRED: swap every token below to the target site's brand. Pull values from
// globals.css / Tailwind preset / brand guide. Do NOT ship with the placeholders.
//   BG          → primary surface (dark sites: near-black; light sites: off-white)
//   FG_TITLE    → accent / hero color (the big center line)
//   FG_TAGLINE  → body text color (slightly muted vs title)
//   FG_MUTED    → tertiary / metadata color (top + bottom rows)
//   FONT_NAME   → font-family used on the site (must match — the card has to read
//                 as a continuation of the site, not a separate poster)
//   FONT_URL    → direct URL to a single-weight font file of FONT_NAME. Get it via
//                 https://fonts.googleapis.com/css2?family=<Name>:wght@700 and copy
//                 the inner `src: url(...)` value. If the site self-hosts the font,
//                 fetch from /public or a CDN instead.
import { ImageResponse } from 'next/og'

export const alt = '{{ALT}}'
export const size = { width: 1200, height: 630 }
export const contentType = 'image/png'
export const runtime = 'edge'

const BG = '{{BG}}'
const FG_TITLE = '{{FG_TITLE}}'
const FG_TAGLINE = '{{FG_TAGLINE}}'
const FG_MUTED = '{{FG_MUTED}}'

const FONT_NAME = '{{FONT_NAME}}'
const FONT_URL = '{{FONT_URL}}'

export default async function OpengraphImage() {
  const font = await fetch(new URL(FONT_URL)).then((res) => res.arrayBuffer())

  return new ImageResponse(
    <div
      style={{
        width: '100%',
        height: '100%',
        background: BG,
        color: FG_TITLE,
        display: 'flex',
        flexDirection: 'column',
        justifyContent: 'space-between',
        padding: 80,
        fontFamily: FONT_NAME,
      }}
    >
      <div style={{ display: 'flex', fontSize: 28, color: FG_MUTED }}>
        {{BRAND}}
      </div>
      <div style={{ display: 'flex', flexDirection: 'column', gap: 24 }}>
        <div
          style={{
            display: 'flex',
            fontSize: 96,
            fontWeight: 700,
            letterSpacing: '-2px',
            color: FG_TITLE,
          }}
        >
          {{TITLE}}
        </div>
        <div
          style={{
            display: 'flex',
            fontSize: 36,
            color: FG_TAGLINE,
            lineHeight: 1.3,
            maxWidth: 980,
          }}
        >
          {{TAGLINE}}
        </div>
      </div>
      <div style={{ display: 'flex', fontSize: 24, color: FG_MUTED }}>
        {{DOMAIN}}
      </div>
    </div>,
    {
      ...size,
      fonts: [
        { name: FONT_NAME, data: font, weight: 700 },
        { name: FONT_NAME, data: font, weight: 400 },
      ],
    },
  )
}
